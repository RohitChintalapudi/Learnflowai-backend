generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  profileImage  String?
  bio           String?   @db.VarChar(300)
  learningGoals String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  explanations          Explanation[]
  interviewQuestionSets InterviewQuestionSet[]
  quizSets              QuizSet[]
  generatedNotes        GeneratedNote[]
  generatedQuizzes      GeneratedQuiz[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Document {
  id         String   @id @default(cuid())
  title      String
  fileName   String
  fileType   String
  fileUrl    String?
  totalPages Int      @default(0)
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chunks       Chunk[]
  explanations          Explanation[]
  interviewQuestionSets InterviewQuestionSet[]
  quizSets              QuizSet[]
  generatedNotes        GeneratedNote[]
  generatedQuizzes      GeneratedQuiz[]

  @@map("documents")
}

model Chunk {
  id         String   @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("chunks")
}

model Explanation {
  id              String   @id @default(cuid())
  userId          String
  documentId      String
  highlightedText String
  explanationText String   @db.Text
  createdAt       DateTime @default(now())

  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("explanations")
}

model InterviewQuestionSet {
  id              String   @id @default(cuid())
  userId          String
  documentId      String
  highlightedText String
  questionsJson   Json     // Stores the generated { basic: [], intermediate: [], advanced: [] }
  createdAt       DateTime @default(now())

  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("interview_question_sets")
}

model QuizSet {
  id              String   @id @default(cuid())
  userId          String
  documentId      String
  highlightedText String
  quizJson        Json     // Stores the generated { mcqs: [], trueFalse: [], shortAnswer: [] }
  score           Int?
  totalQuestions  Int?
  status          String   @default("PENDING") // "PENDING" | "COMPLETED"
  topicsToImprove Json?    // Array of string topics
  createdAt       DateTime @default(now())

  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_sets")
}

model GeneratedNote {
  id              String   @id @default(cuid())
  userId          String
  documentId      String
  highlightedText String
  title           String
  notes           Json
  createdAt       DateTime @default(now())

  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("generated_notes")
}

model GeneratedQuiz {
  id              String   @id @default(cuid())

  userId          String
  documentId      String

  title           String
  highlightedText String

  quizData        Json

  totalQuestions  Int

  createdAt       DateTime @default(now())

  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("generated_quizzes")
}
